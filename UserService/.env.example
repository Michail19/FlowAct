# ======================
# USER SERVICE
# ======================
SERVER_PORT=8083
SPRING_PROFILES_ACTIVE=init

# ======================
# DATABASE
# ======================
# Local separate database example:
# DB_URL=jdbc:postgresql://localhost:5433/flowact_users
# Docker Compose separate database example:
# DB_URL=jdbc:postgresql://user-db:5432/flowact_users
DB_URL=jdbc:postgresql://localhost:5433/flowact_users
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ======================
# JWT
# ======================
# Use a long random value in production.
JWT_SECRET=change-this-dev-secret-change-this-dev-secret
JWT_ISSUER=flowact-user-service
JWT_ACCESS_TOKEN_TTL_MINUTES=30
JWT_REFRESH_TOKEN_TTL_DAYS=14

# ======================
# PASSWORD HASHING
# ======================
BCRYPT_STRENGTH=12

# ======================
# OPENAPI
# ======================
OPENAPI_ENABLED=true
SWAGGER_UI_ENABLED=true

# ======================
# ACTUATOR
# ======================
HEALTH_DETAILS=always

# ======================
# CORS
# ======================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type
CORS_ALLOW_CREDENTIALS=true

# ======================
# LOGGING
# ======================
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_WEB=INFO
LOG_LEVEL_SECURITY=INFO
LOG_LEVEL_SQL=INFO
LOG_LEVEL_BIND=INFO
LOG_LEVEL_APP=INFO
