# =========================
# FlowAct Frontend env
# =========================
#
# Copy before local frontend launch:
#
# cp .env.example .env
#
# Vite reads env variables only when dev server starts.
# Restart npm run dev after changing this file.

# =========================
# API
# =========================

# Use this when frontend runs separately via npm run dev.
# Vite will proxy /api/v1/auth and /api/v1/users to UserService,
# and other /api requests to ExecutionService.
VITE_API_BASE_URL=/api
VITE_ML_SERVICE_BASE_URL=http://localhost:8000
VITE_DEV_USER_API_PROXY_TARGET=http://localhost:8083
VITE_DEV_EXECUTION_API_PROXY_TARGET=http://localhost:8082

# Use this when frontend is served by Docker nginx:
# VITE_API_BASE_URL=/api

# =========================
# Dev auth
# =========================
#
# Must stay disabled after UserService/JWT integration.
# UserService issues Bearer JWT, ExecutionService validates it.

VITE_DEV_AUTH_ENABLED=false
VITE_DEV_USER_ID=11111111-1111-1111-1111-111111111111
VITE_DEV_AUTH_TOKEN=dev-token
