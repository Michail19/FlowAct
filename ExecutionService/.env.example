# =========================
# ExecutionService env
# =========================
#
# Copy before local launch:
#
# cp .env.example .env
#
# If you run service from IDE, add these variables to Run Configuration.

# =========================
# Core
# =========================

SPRING_PROFILES_ACTIVE=init
SERVER_PORT=8082

# =========================
# Datasource
# =========================
#
# Use localhost:5433 when PostgreSQL is started by root docker-compose.yml.
# Docker maps host 5433 -> container 5432.

DB_URL=jdbc:postgresql://localhost:5433/flowact_execution
DB_USERNAME=postgres
DB_PASSWORD=postgres

# For running ExecutionService inside Docker network use:
# DB_URL=jdbc:postgresql://postgres:5432/flowact_execution

# =========================
# JPA / Flyway
# =========================

JPA_SHOW_SQL=true

# Hibernate uses ddl-auto=validate in application.properties.
# Schema changes must be added through Flyway migrations.

# =========================
# Internal services
# =========================

AUTH_SERVICE_URL=http://localhost:8083
ML_SERVICE_URL=http://localhost:8000
GATEWAY_SERVICE_URL=http://localhost:8080
SCHEDULE_SERVICE_URL=http://localhost:8084

# =========================
# HTTP timeouts
# =========================

HTTP_CONNECT_TIMEOUT=5000
HTTP_READ_TIMEOUT=15000

# =========================
# Execution settings
# =========================

EXECUTION_MAX_DEPTH=100
EXECUTION_DEFAULT_PAGE_SIZE=20
EXECUTION_MAX_PAGE_SIZE=100

# =========================
# OpenAPI / Swagger
# =========================

OPENAPI_ENABLED=true
SWAGGER_UI_ENABLED=true

# =========================
# Actuator
# =========================

HEALTH_DETAILS=always

# =========================
# Logging
# =========================

LOG_LEVEL_ROOT=INFO
LOG_LEVEL_WEB=DEBUG
LOG_LEVEL_SQL=DEBUG
LOG_LEVEL_BIND=TRACE
LOG_LEVEL_APP=DEBUG

# =========================
# Kafka
# =========================

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=flowact-execution-service
KAFKA_AUTO_OFFSET_RESET=earliest

FLOWACT_KAFKA_EXECUTION_RUN_REQUESTED_TOPIC=flowact.execution.run.requested
FLOWACT_KAFKA_EXECUTION_RETRY_REQUESTED_TOPIC=flowact.execution.retry.requested
FLOWACT_KAFKA_EXECUTION_RESUME_REQUESTED_TOPIC=flowact.execution.resume.requested
FLOWACT_KAFKA_EXECUTION_CANCEL_REQUESTED_TOPIC=flowact.execution.cancel.requested
